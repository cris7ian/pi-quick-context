{
  "name": "pi-quick-context",
  "version": "0.1.1",
  "description": "Print session context inline in pi: loaded context files, skills, prompt templates, extensions, tools, and keybinding hints.",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "context"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cris7ian/pi-quick-context.git"
  },
  "homepage": "https://github.com/cris7ian/pi-quick-context",
  "bugs": {
    "url": "https://github.com/cris7ian/pi-quick-context/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/cris7ian/pi-quick-context/main/docs/preview.png"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.7.0"
  }
}
